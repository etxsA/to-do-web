# Copy to `.env` and fill in. VITE_* vars are inlined into the client bundle
# (public, like the mobile app's EXPO_PUBLIC_* — the Firebase web apiKey is not a secret).
# Real values for this project are provided with the submission, not committed.

# Backend (Quarkus REST API) base URL — no trailing slash, no /api prefix.
VITE_API_BASE_URL=https://your-backend-url.example.com

# Firebase Web config (Project settings -> Your apps -> Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
